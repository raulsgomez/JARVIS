# ============================================================
# JARVIS — Plantilla de configuración personal
# Copia este archivo como .env y rellena tus valores
# ============================================================

# --- IDs personales ---

# Tu Telegram user ID (numérico). Obtenlo con @userinfobot en Telegram.
JARVIS_TELEGRAM_ALLOWED_USER_IDS=[YOUR_TELEGRAM_USER_ID]

# Tu LinkedIn person URN. Se obtiene en la respuesta de la API de LinkedIn
# o con una llamada a GET https://api.linkedin.com/v2/userinfo
JARVIS_LINKEDIN_PERSON_ID=urn:li:person:YOUR_PERSON_ID

# IP Tailscale de tu Mac para acceso remoto a la galería de fotos.
# Déjalo vacío si solo necesitas acceso en red local.
JARVIS_WEB_TAILSCALE_IP=

# Email de tu cuenta de iCloud para sincronizar Apple Calendar via CalDAV.
JARVIS_CALDAV_USERNAME=your@icloud.com

# --- Secrets (alternativa al macOS Keychain) ---
# En macOS, JARVIS lee los secrets del Keychain automáticamente.
# Solo rellena estas variables si no usas macOS Keychain:
#
#   python -c "import keyring; keyring.set_password('jarvis', 'telegram_bot_token', 'TU_TOKEN')"
#
# JARVIS_TELEGRAM_BOT_TOKEN=
# JARVIS_ANTHROPIC_API_KEY=sk-ant-...
# JARVIS_GOOGLE_API_KEY=
# JARVIS_LINKEDIN_ACCESS_TOKEN=
# JARVIS_CALDAV_PASSWORD=
# JARVIS_GALLERY_TOKEN=

# --- Opciones generales (opcionales) ---
# JARVIS_DEBUG=false
# JARVIS_LOG_LEVEL=INFO
